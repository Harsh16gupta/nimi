# Optional: interactive `nimi` saves keys via /login to ~/.nimi/auth.json instead.
# Set these only for headless/CI use (or as an alternative to /login).
# META_API_KEY=your meta api key
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# XAI_API_KEY=xai-...
# MOONSHOT_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# DASHSCOPE_API_KEY=sk-...
# ZAI_API_KEY=...
# Custom OpenAI-compatible endpoint (provider id "custom"):
# NIMI_BASE_URL=https://your-host/v1
# NIMI_API_KEY=your key (or run /login custom)
# NIMI_MODEL=model id served by that endpoint
